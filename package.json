{
  "name": "better-t-stack-template",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.5.4",
      "typescript": "^6.0.3",
      "varlock": "1.23.0",
      "next-themes": "^0.4.6",
      "sonner": "^2.0.8",
      "tailwindcss": "^4.3.3",
      "@orpc/server": "^1.15.6",
      "@orpc/client": "^1.15.6",
      "@orpc/openapi": "^1.15.6",
      "@orpc/zod": "^1.15.6",
      "better-auth": "1.7.12",
      "drizzle-orm": "1.0.0-rc.5"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web --",
    "db:push": "turbo run db:push -F @better-t-stack-template/db --",
    "db:studio": "turbo run db:studio -F @better-t-stack-template/db --",
    "db:generate": "turbo run db:generate -F @better-t-stack-template/db --",
    "db:migrate": "turbo run db:migrate -F @better-t-stack-template/db --",
    "db:start": "docker compose up -d postgres",
    "db:watch": "docker compose up postgres",
    "db:stop": "docker compose stop postgres",
    "db:down": "docker compose down postgres",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./packages/db/",
    "auth:generate": "cd apps/web && bun run auth:generate",
    "check": "oxlint && oxfmt --check",
    "test": "turbo run test",
    "lint": "oxlint",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "db:seed": "bun run --cwd apps/web db:seed"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@better-t-stack-template/config": "workspace:*",
    "@types/node": "^26.4.1",
    "lefthook": "^2.2.1",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.87.0",
    "turbo": "^2.11.7",
    "typescript": "catalog:",
    "varlock": "catalog:"
  },
  "packageManager": "bun@1.4.4"
}
