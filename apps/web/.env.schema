# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# Public origin of the app (also used to build email links). Not a secret.
# @type=url @sensitive=false
BETTER_AUTH_URL=

# @type=string(minLength=1)
DATABASE_URL=

# --- Seed (only used by `bun run db:seed`) ---
# Email of the first system admin to create/promote.
# Not sensitive: varlock would otherwise redact/block it wherever the admin's email appears.
# @required=false @sensitive=false @type=email
SEED_ADMIN_EMAIL=
# Password for a newly created admin (ignored if the user already exists)
# @required=false @type=string(minLength=8)
SEED_ADMIN_PASSWORD=
# @required=false @sensitive=false
SEED_ADMIN_NAME=Admin
