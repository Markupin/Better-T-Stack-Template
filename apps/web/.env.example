# Copy to apps/web/.env and fill in. Validated by varlock against .env.schema
# (`bunx varlock load --path apps/web` to check).

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Public origin of the app, no trailing slash. Production: https://your-domain.com
BETTER_AUTH_URL=http://localhost:3001
# Local development database (docker compose `postgres` service).
# In docker compose this is overridden to point at the `postgres` service.
DATABASE_URL=postgresql://postgres:password@localhost:5432/better-t-stack-template

# Optional: first admin for `bun run db:seed`
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-please
SEED_ADMIN_NAME=Admin
