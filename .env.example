# Root .env: variables read by docker-compose.yml (production / VPS).
# App configuration lives in apps/web/.env (see apps/web/.env.example).

# Postgres password for the compose `postgres` service. CHANGE IT in production.
POSTGRES_PASSWORD=change-me-to-a-long-random-password
# Host port the web container is published on (bound to 127.0.0.1).
WEB_PORT=3001
